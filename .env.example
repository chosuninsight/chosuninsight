# ChosunInsight Chatbot — Environment Variables
# Copy this file to .env and fill in your actual API keys.
# .env is gitignored; .env.example is committed.

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Which LLM to use. Set to "openai" or "gemini".
LLM_PROVIDER=openai

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Google Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=AIza...
# Model ID — gemini-2.5-flash-lite is the lightweight fast model
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── 벡터 데이터베이스 (ChromaDB) 설정 ─────────────────────────────────────
# 추가: 서버 관리자가 실제 DB를 저장할 호스트의 물리적 경로
# docker-compose.yml의 HOST_DB_PATH와 연결됩니다.
HOST_DB_PATH=./chroma_db_store

# 추가: 컨테이너 내부 가상 경로 (main.py의 PERSIST_DIRECTORY와 일치해야 함)
PERSIST_DIRECTORY=/app/chroma_db

# 추가: 갱신용 DB 경로 (Update date.py가 사용하는 이름과 일치)
UPDATE_DB_DIRECTORY=/app/chroma_db_update

# 추가: 사용할 임베딩 모델 (학습 시 사용한 모델과 일치해야 함)
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

COLLECTION_NAME=langchain

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No trailing slash.
# Example for production: ALLOWED_ORIGINS=https://chosuninsight.example.com
ALLOWED_ORIGINS=http://localhost:5173

# ─── Conversation History ────────────────────────────────────────────────────
# Maximum number of conversation turns kept per session (user+assistant = 1 turn).
# Higher values = more context but higher token cost. Default 10.
MAX_HISTORY_TURNS=10

# ─── Web Search (Jina AI) ──────────────────────────────────────────────────
# Enable/disable Jina-based web search. Default "true".
WEB_SEARCH_ENABLED=true
# Jina AI API Key (s.jina.ai)
JINA_API_KEY=jina_...
# Model to use for web search agent. Default is CHAT_MODEL_NAME.
WEB_SEARCH_MODEL=gpt-4o-mini
# Maximum number of search results to retrieve. Default 5.
WEB_SEARCH_MAX_RESULTS=5

# ─── Debug ───────────────────────────────────────────────────────────────────
# Set to "true" to include exception details in error responses (dev only).
DEBUG=false
