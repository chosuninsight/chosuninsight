  "academic_administration_info": {
    "leave_of_absence": {
      "general": "학기 개시 전 또는 개시 후 수업일수 1/4선 이전까지 신청 가능합니다. 2회차 신청부터는 반드시 지도교수 상담 후 상담기록부를 첨부해야 합니다. (총 4회 가능, 1회 최대 1년)",
      "military": "입영일 28일 전부터 신청 가능하며, 입영통지서 사본을 제출해야 합니다.",
      "reinstatement": "1학기는 1~2월, 2학기는 7~8월 정해진 기간에 온라인 신청합니다. 군복학 시 전역 증빙 서류가 필요합니다."
    },
    "scholarship": {
      "baegak_merit": "성적 상위 50% 이내 및 기준 학점(17학점) 이수자 대상입니다. 학과별로 외국어 성적 기준이 다를 수 있으니 확인이 필요합니다.",
      "national": "한국장학재단에서 신청하며, 소득 구간(0~8구간) 및 성적(B학점 이상) 기준을 충족해야 합니다.",
      "welfare": "국가장학금을 신청한 8구간 이내 학생 중 선정하여 지급합니다."
    },
    "credit_exchange": {
      "qualification": "평균 평점 3.0(B0) 이상 및 학기당 평균 17학점 이상 이수한 재학생이 지원할 수 있습니다.",
      "process": "본교에서 승인을 받은 후 교류 대학 시스템에서 직접 수강신청을 진행하며, 등록금은 본교에 납부합니다."
    },
    "graduation_deferment": {
      "qualification": "졸업 요건을 모두 충족한 '졸업가능자'만 신청 가능하며, 최대 연속 3회까지 가능합니다.",
      "fee": "수강 미신청 시 유예비 10만원이 발생하며, 미납 시 수료 처리되어 자동 졸업 대상이 됩니다."
    }
  }
}
