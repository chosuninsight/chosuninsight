  "general_education_2023": {
    "source": "2026학년도 1학기 수강가이드 교양과정 이수 안내",
    "source_file": "2026_1학기_수강가이드_추출.txt",
    "academic_year": 2023,
    "admission_cohort": "2023학년도 이후 입학생",
    "minimum_credits": 30,
    "items": [
      {
        "name": "함께형교양",
        "requirement": "필수 3학점. 신입생세미나(41874) 1학점을 이수하고, 남은 2학점은 함께형교양 영역 교과목에서 자유롭게 선택"
      },
      {
        "name": "기초교양-의사소통",
        "requirement": "열린사고와표현, 매체와의사소통, 말하기와실용글쓰기 중 학과별 편성 1과목 3학점 필수"
      },
      {
        "name": "기초교양-영어",
        "requirement": "영어 기초학력진단 결과에 따라 EGC 2학점과 EAL 2학점 과목을 이수"
      },
      {
        "name": "기초교양-정보(SW·AI)",
        "requirement": "계열별 입학 전 교육 1학점(P/N)과 정규 학기 SW·AI 교과목 3학점 필수"
      },
      {
        "name": "기초교양-기초자연과학",
        "requirement": "공학·자연계열은 학과별 교양필수 편성 교과목 3학점 이상 이수. 공학교육인증 학과는 MSC 24학점 이상"
      },
      {
        "name": "균형교양",
        "requirement": "공학·자연계열은 개성교육, 생산교육 영역에서 6학점 이상 선택 이수"
      },
      {
        "name": "융합교양",
        "requirement": "창의·융합 및 창작·응용 세부영역 구분 없이 3학점 이상 선택 이수"
      },
      {
        "name": "더블리스팅/선택교양",
        "requirement": "필수 이수학점 없음. 영역별 필수 이수학점을 채운 뒤 잔여 교양학점을 선택교양 등으로 이수 가능"
      }
    ]
  }
